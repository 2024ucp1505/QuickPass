# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/quickpass

# JWT Secret (use a long, random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# AES-256 Encryption Key (must be exactly 32 characters for AES-256)
AES_ENCRYPTION_KEY=your_32_char_aes_key_here_change_

# Server Port
PORT=5000

# Email Configuration (for Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=QuickPass <your_email@gmail.com>

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
